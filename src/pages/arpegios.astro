---
import Layout from "@/layouts/Layout.astro";
import TabPlayer from "@/components/TabPlayer.astro";
import FingerLegend from "@/components/FingerLegend.astro";
import { arpeggios } from "@/data/arpeggios";
---

<Layout title="Arpegios" description="Arpegios básicos para guitarra sobre acordes abiertos comunes, con reproducción interactiva.">
  <h1 class="page-title">Arpegios básicos</h1>
  <p class="page-lead">
    Fila "Mano izq." = qué dedo pisa cada traste ("-" = cuerda al aire). Cada dedo tiene su propio color,
    igual que en Acordes:
  </p>
  <FingerLegend />
  <p class="lead">
    Fila "Mano der." = con qué dedo pulsas (p=pulgar, i=índice, m=medio, a=anular).
    Practica lento y limpio antes de subir velocidad.
  </p>

  <div class="arp-list">
    {arpeggios.map((arp) => (
      <article class="arp-card" id={arp.id}>
        <div class="arp-head">
          <h3>{arp.chordName}</h3>
          <a href={`/acordes#chord-${arp.chordId}`} class="chord-link">Ver forma del acorde →</a>
        </div>
        <p>{arp.description}</p>
        <TabPlayer notes={arp.sequence} bpm={70} fingering={arp.fingering} leftFingers={arp.leftFingers} />
      </article>
    ))}
  </div>
</Layout>

<style>
  .lead {
    color: #475569;
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }
  .arp-list {
    display: grid;
    gap: 1.25rem;
  }
  .arp-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
    padding: 1.25rem;
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .arp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .arp-card h3 {
    margin: 0;
  }
  .chord-link {
    font-size: 0.8rem;
    color: #0f766e;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .chord-link:hover {
    text-decoration: underline;
  }
  .arp-card p {
    color: #475569;
    margin: 0;
  }
</style>
