---
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import FloatingMetronome from "@/components/FloatingMetronome.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Aprende guitarra desde cero: ejercicios, notas, ritmos y retos diarios." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎸</text></svg>" />
    <title>{title} · Tutorial Guitar</title>
  </head>
  <body class="site-body">
    <Navbar />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Practica un poco cada día. La constancia gana más que las maratones de fin de semana.</p>
      <details class="disclaimer">
        <summary>⚠️ Aviso</summary>
        <p>
          Herramienta educativa: no somos tutores ni maestros de guitarra, solo es un
          proyecto que busca ayudar a los principiantes a practicar y apoyar el estudio
          autodidacta de las personas que gustan de aprender a tocar guitarra.
        </p>
      </details>
      <p class="site-footer-credit">
        Hecho por <a href="https://cacharreo.dev/" target="_blank" rel="noopener noreferrer">cacharreo.dev</a>
      </p>
    </footer>
    <FloatingMetronome />
  </body>
</html>

<script>
  if (window.location.hash) {
    const target = document.getElementById(window.location.hash.slice(1));
    if (target) {
      // Si el objetivo vive dentro de un <details> colapsado (ej. un
      // ejercicio de género en /ejercicios), ábrelo antes de resaltar.
      let ancestor = target.closest("details");
      let openedHidden = false;
      while (ancestor) {
        if (!ancestor.open) {
          ancestor.open = true;
          openedHidden = true;
        }
        ancestor = ancestor.parentElement?.closest("details") ?? null;
      }
      if (openedHidden) {
        target.scrollIntoView({ block: "start" });
      }
      target.classList.add("highlight-target");
      setTimeout(() => target.classList.remove("highlight-target"), 1800);
    }
  }
</script>

<style is:global>
  :root {
    color-scheme: light;
  }
  body.site-body {
    margin: 0;
    background: #f8fafc;
    color: #0f172a;
    font-family: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
  }
  .site-main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
  .site-footer {
    text-align: center;
    padding: 2rem 1rem 3rem;
    color: #64748b;
    font-size: 0.875rem;
  }
  .disclaimer {
    max-width: 32rem;
    margin: 0.85rem auto 0;
    text-align: left;
  }
  .disclaimer summary {
    cursor: pointer;
    text-align: center;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: #b45309;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    display: inline-block;
    width: fit-content;
    margin: 0 auto;
  }
  .disclaimer summary::-webkit-details-marker {
    display: none;
  }
  .disclaimer[open] summary {
    border-radius: 0.6rem 0.6rem 0 0;
    display: block;
    text-align: center;
  }
  .disclaimer p {
    margin: 0;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-top: none;
    border-radius: 0 0 0.6rem 0.6rem;
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #78350f;
  }
  .site-footer-credit {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .site-footer-credit a {
    color: #64748b;
    font-weight: 600;
    text-decoration: none;
  }
  .site-footer-credit a:hover {
    color: #f59e0b;
    text-decoration: underline;
  }
  h1, h2, h3 {
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  /* Mismo formato en todas las páginas: espacio bajo el menú, título y
     descripción, igual que en Inicio. */
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    margin: 2.5rem 0 0.5rem;
  }
  .page-lead {
    color: #475569;
    font-size: 1.05rem;
    max-width: 70rem;
    margin: 0 0 1.5rem;
  }
  [id] {
    scroll-margin-top: 4.5rem;
  }
  .highlight-target {
    animation: highlight-pulse 1.8s ease;
  }
  @keyframes highlight-pulse {
    0% {
      box-shadow: 0 0 0 3px #f59e0b;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
    }
  }
</style>
