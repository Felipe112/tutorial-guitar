---
import { chordById } from "@/data/chords";

interface Props {
  chordId: string;
}
const { chordId } = Astro.props;
const chord = chordById(chordId);
---

{chord && (
  <button type="button" class="chord-tag" data-chord={JSON.stringify(chord)}>
    {chord.shortName}
  </button>
)}

<style>
  .chord-tag {
    display: inline-flex;
    align-items: center;
    background: #f1f5f9;
    color: #0f766e;
    font-weight: 700;
    font-size: 0.8rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    line-height: 1.4;
  }
  .chord-tag:hover,
  .chord-tag:focus-visible {
    background: #ccfbf1;
    border-color: #0f766e;
    outline: none;
  }
</style>

<style is:global>
  .chord-tooltip {
    position: absolute;
    z-index: 100;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.6rem;
    padding: 0.65rem 0.75rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
    font-size: 0.75rem;
    display: none;
    max-width: 13rem;
  }
  .chord-tooltip.visible {
    display: block;
  }
  .chord-tooltip .ct-name {
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }
  .chord-tooltip .ct-markers,
  .chord-tooltip .ct-row {
    display: grid;
    grid-template-columns: repeat(6, 1.15rem);
  }
  .chord-tooltip .ct-markers span {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    height: 0.9rem;
    color: #475569;
  }
  .chord-tooltip .ct-mute {
    color: #ef4444;
  }
  .chord-tooltip .ct-open {
    color: #10b981;
  }
  .chord-tooltip .ct-grid {
    border-top: 2px solid #1e293b;
    background-image: repeating-linear-gradient(
      to right,
      #cbd5e1 0,
      #cbd5e1 1px,
      transparent 1px,
      transparent 1.15rem
    );
  }
  .chord-tooltip .ct-grid.ct-no-nut {
    border-top: 1px solid #cbd5e1;
  }
  .chord-tooltip .ct-row {
    height: 1.2rem;
    border-bottom: 1px solid #e2e8f0;
    position: relative;
  }
  .chord-tooltip .ct-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .chord-tooltip .ct-bar {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 0.95rem;
    background: rgba(245, 158, 11, 0.35);
    border-radius: 999px;
    z-index: 0;
  }
  .chord-tooltip .ct-dot {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    color: white;
    font-weight: 800;
    font-size: 0.62rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .chord-tooltip .ct-base {
    font-size: 0.65rem;
    color: #94a3b8;
    font-weight: 700;
    margin-top: 0.2rem;
  }
  .chord-tooltip .ct-link {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: #0f766e;
    font-weight: 600;
    text-decoration: none;
  }
  .chord-tooltip .ct-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  import type { ChordShape } from "@/data/chords";
  import { fingerColor } from "@/lib/fingerColors";

  function ensureTooltip(): HTMLElement {
    let el = document.getElementById("chord-tooltip-global");
    if (!el) {
      el = document.createElement("div");
      el.id = "chord-tooltip-global";
      el.className = "chord-tooltip";
      el.setAttribute("role", "tooltip");
      document.body.appendChild(el);
    }
    return el;
  }

  function renderTooltipHTML(chord: ChordShape): string {
    const frets = 4;
    const baseFret = chord.baseFret ?? 1;
    const byString = [...chord.positions].sort((a, b) => a.string - b.string);
    const barreSpans = chord.barreSpans ?? [];

    const markers = byString
      .map((p) => {
        if (p.fret === null) return '<span class="ct-mute">✕</span>';
        if (p.fret === 0) return '<span class="ct-open">○</span>';
        return "<span></span>";
      })
      .join("");

    let rows = "";
    for (let rowIdx = 0; rowIdx < frets; rowIdx++) {
      const fretAbs = baseFret + rowIdx;
      const barre = barreSpans.find((b) => b.fret === fretAbs);
      const bar = barre
        ? `<span class="ct-bar" style="grid-column: ${barre.fromString + 1} / ${barre.toString + 2}; background: ${fingerColor(barre.finger)}40;"></span>`
        : "";
      const cells = byString
        .map((p) => {
          if (p.fret !== null && p.fret === fretAbs) {
            return `<div class="ct-cell"><span class="ct-dot" style="background: ${fingerColor(p.finger)};">${p.finger ?? ""}</span></div>`;
          }
          return '<div class="ct-cell"></div>';
        })
        .join("");
      rows += `<div class="ct-row">${bar}${cells}</div>`;
    }

    const baseLabel = baseFret > 1 ? `<div class="ct-base">${baseFret}fr</div>` : "";

    return `
      <div class="ct-name">${chord.name} (${chord.shortName})</div>
      <div class="ct-markers">${markers}</div>
      <div class="ct-grid ${baseFret > 1 ? "ct-no-nut" : ""}">${rows}</div>
      ${baseLabel}
      <a class="ct-link" href="/acordes#chord-${chord.id}">Ver detalle →</a>
    `;
  }

  function positionTooltip(tooltip: HTMLElement, anchor: HTMLElement) {
    const rect = anchor.getBoundingClientRect();
    const top = rect.bottom + window.scrollY + 8;
    const left = rect.left + window.scrollX;
    tooltip.style.top = `${top}px`;
    tooltip.style.left = `${left}px`;
    requestAnimationFrame(() => {
      const tRect = tooltip.getBoundingClientRect();
      const overflowRight = tRect.right - window.innerWidth;
      if (overflowRight > 0) {
        tooltip.style.left = `${Math.max(8, left - overflowRight - 8)}px`;
      }
    });
  }

  function hideTooltip() {
    document.getElementById("chord-tooltip-global")?.classList.remove("visible");
  }

  function initTag(btn: HTMLButtonElement) {
    const chord = JSON.parse(btn.dataset.chord ?? "null") as ChordShape | null;
    if (!chord) return;
    let pinned = false;

    function show() {
      const tooltip = ensureTooltip();
      tooltip.innerHTML = renderTooltipHTML(chord!);
      tooltip.classList.add("visible");
      positionTooltip(tooltip, btn);
    }

    btn.addEventListener("mouseenter", show);
    btn.addEventListener("mouseleave", () => {
      if (!pinned) hideTooltip();
    });
    btn.addEventListener("focus", show);
    btn.addEventListener("blur", () => {
      if (!pinned) hideTooltip();
    });
    btn.addEventListener("click", () => {
      pinned = !pinned;
      if (pinned) show();
      else hideTooltip();
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".chord-tag").forEach(initTag);

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".chord-tag") && !target.closest(".chord-tooltip")) {
      hideTooltip();
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideTooltip();
  });
</script>
