---
import { fingerColor } from "@/lib/fingerColors";

interface NoteStep {
  string: number; // 0 = 6ta .. 5 = 1ra
  fret: number;
  beats?: number;
}

interface Props {
  notes: NoteStep[];
  bpm: number;
  fingering?: string[]; // mano derecha: p/i/m/a
  leftFingers?: string[]; // mano izquierda: 1/2/3/4 o "-" si es al aire
}
const { notes, bpm, fingering, leftFingers } = Astro.props;
const stringOrder = [5, 4, 3, 2, 1, 0]; // top row = 1ra (aguda), bottom = 6ta (grave)
const stringLabel = ["1ra", "2da", "3ra", "4ta", "5ta", "6ta"];
---

<div class="tabplayer" data-notes={JSON.stringify(notes)} data-bpm={bpm}>
  <div class="tab-grid" style={`--steps: ${notes.length}`}>
    {stringOrder.map((s, rowIdx) => (
      <div class="tab-row">
        <span class="tab-string-label">{stringLabel[rowIdx]}</span>
        <div class="tab-cells">
          {notes.map((n, stepIdx) => (
            <div class="tab-cell" data-step={stepIdx}>
              {n.string === s ? <span class="fret-num">{n.fret}</span> : <span class="tab-line"></span>}
            </div>
          ))}
        </div>
      </div>
    ))}
    {leftFingers && (
      <div class="tab-row fingering-row">
        <span class="tab-string-label">Mano izq.</span>
        <div class="tab-cells">
          {leftFingers.map((f, i) => {
            const n = Number(f);
            const hasColor = f !== "-" && !Number.isNaN(n) && n > 0;
            return (
              <div class="tab-cell" data-step={i}>
                <span class="finger-label left" style={hasColor ? `background:${fingerColor(n)}; color:white;` : ""}>{f}</span>
              </div>
            );
          })}
        </div>
      </div>
    )}
    {fingering && (
      <div class="tab-row fingering-row">
        <span class="tab-string-label">Mano der.</span>
        <div class="tab-cells">
          {fingering.map((f, i) => (
            <div class="tab-cell" data-step={i}>
              <span class="finger-label">{f}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
  <button type="button" class="tab-play">▶ Reproducir</button>
</div>

<style>
  .tabplayer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
  }
  .tab-grid {
    overflow-x: auto;
    background: #0f172a;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    min-width: 0;
    max-width: 100%;
    /* Barra de scroll siempre visible (en vez de la del SO, que en macOS
       suele estar oculta hasta que haces scroll) para que se note de un
       vistazo que hay más tablatura a los lados. */
    scrollbar-width: thin;
    scrollbar-color: #f59e0b #1e293b;
  }
  .tab-grid::-webkit-scrollbar {
    height: 0.5rem;
  }
  .tab-grid::-webkit-scrollbar-track {
    background: #1e293b;
    border-radius: 999px;
  }
  .tab-grid::-webkit-scrollbar-thumb {
    background: #f59e0b;
    border-radius: 999px;
  }
  .tab-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tab-string-label {
    width: 2.5rem;
    flex-shrink: 0;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .tab-cells {
    display: flex;
  }
  .tab-cell {
    width: 2.25rem;
    height: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .tab-cell.active {
    background: rgba(245, 158, 11, 0.25);
    border-radius: 0.25rem;
  }
  .tab-line {
    width: 100%;
    height: 1px;
    background: #475569;
  }
  .fret-num {
    color: #fbbf24;
    font-weight: 700;
    background: #0f172a;
    z-index: 1;
    min-width: 1.2rem;
    text-align: center;
  }
  .finger-label {
    color: #38bdf8;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .finger-label.left {
    color: #fb923c;
    min-width: 1.35rem;
    min-height: 1.35rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .fingering-row {
    margin-top: 0.4rem;
    border-top: 1px dashed #334155;
    padding-top: 0.4rem;
  }
  .tab-play {
    align-self: flex-start;
    background: #0f766e;
    color: white;
    border: none;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script>
  import { fretToFrequency, pluckNote, unlockAudio } from "@/lib/audio";

  interface NoteStep {
    string: number;
    fret: number;
    beats?: number;
  }

  function initTabPlayer(root: HTMLElement) {
    const notes = JSON.parse(root.dataset.notes ?? "[]") as NoteStep[];
    const bpm = Number(root.dataset.bpm ?? 90);
    const playBtn = root.querySelector<HTMLButtonElement>(".tab-play")!;
    const cellsByStep = new Map<number, HTMLElement[]>();
    root.querySelectorAll<HTMLElement>(".tab-cell").forEach((cell) => {
      const step = Number(cell.dataset.step);
      const list = cellsByStep.get(step) ?? [];
      list.push(cell);
      cellsByStep.set(step, list);
    });

    let playing = false;
    let timeoutIds: number[] = [];

    function clearActive() {
      root.querySelectorAll(".tab-cell.active").forEach((c) => c.classList.remove("active"));
    }

    function stop() {
      playing = false;
      playBtn.textContent = "▶ Reproducir";
      timeoutIds.forEach((id) => window.clearTimeout(id));
      timeoutIds = [];
      clearActive();
    }

    function play() {
      unlockAudio();
      playing = true;
      playBtn.textContent = "■ Detener";
      const beatMs = (60 / bpm) * 1000;
      let elapsed = 0;
      notes.forEach((note, i) => {
        const id = window.setTimeout(() => {
          clearActive();
          cellsByStep.get(i)?.forEach((c) => c.classList.add("active"));
          pluckNote(fretToFrequency(note.string, note.fret), 0.8);
        }, elapsed);
        timeoutIds.push(id);
        elapsed += (note.beats ?? 1) * beatMs;
      });
      const endId = window.setTimeout(stop, elapsed);
      timeoutIds.push(endId);
    }

    playBtn.addEventListener("click", () => {
      playing ? stop() : play();
    });
  }

  document.querySelectorAll<HTMLElement>(".tabplayer").forEach(initTabPlayer);
</script>
